# ─────────────────────────────────────────────────────────────────────────
#  AI Test Engine — Variables d'environnement
#  Copie ce fichier en .env et adapte les valeurs.
# ─────────────────────────────────────────────────────────────────────────

# Connexion PostgreSQL (REQUIS — pas de défaut)
DATABASE_URL=postgresql://admin:secret_ai_password@vector-db:5432/knowledge_base

# Endpoint Ollama (LLM local).
# Ollama est CONTENEURISÉ : on vise le nom du service Docker, pas l'hôte.
# Hors Docker (exécution nue sur le poste) : http://localhost:11434/api/generate
OLLAMA_URL=http://ollama:11434/api/generate

# Modèles
DEFAULT_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Doit correspondre au modèle téléchargé par le service `ollama-pull`
# (docker-compose.yml). En changer un sans l'autre = « model not found ».
DEFAULT_LLM_MODEL=qwen2.5-coder:3b

# Allowlist des modèles d'embedding chargeables via l'API
ALLOWED_EMBEDDING_MODELS=paraphrase-multilingual-MiniLM-L12-v2,all-MiniLM-L6-v2,all-mpnet-base-v2

# ─── Projet Symfony analysé ──────────────────────────────────────────────
# Chemin du projet à analyser, relatif au docker-compose.yml.
# Défaut « .. » : le moteur est un sous-dossier du projet analysé.
# Projets côte à côte : PROJECT_PATH=../mon-projet
# Le nom du projet ne figure donc nulle part dans le dépôt versionné.
PROJECT_PATH=..

# Racine du projet Symfony monté dans le conteneur.
# À ne changer que si le projet est dans un sous-dossier du point de montage.
CONTAINER_PROJECT_ROOT=/workspace

# ─── Authentification ────────────────────────────────────────────────────
# Clé API requise sur tous les endpoints d'écriture (header X-API-Key).
# Laisser vide en dev local. À DÉFINIR en production.
API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────
# Liste d'origines autorisées séparées par des virgules.
# Vide = CORS désactivé. "*" = tout autorisé (dev uniquement).
CORS_ORIGINS=

# ─── Authentification Symfony (cible des tests générés) ──────────────────
AUTH_FIREWALL_NAME=secured_area
AUTH_REDIRECT_PATH=/connect/web-sso
AUTH_REDIRECT_STATUS=307
AUTH_TEST_ROLES=ADMIN,CONSULT
# Mapping rôle Symfony → clé TestUserFactory (vide si identique)
AUTH_ROLE_KEY_MAP=
AUTH_TEST_CLASS=App\Tests\Security\TestUserFactory
AUTH_SSO_USER_CLASS=Cnam\WebSSOBundle\User\WebSSOUser
